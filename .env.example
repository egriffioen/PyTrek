# Copy this file to .env.local and fill in real values.
# .env.local is ignored by git; never commit real secrets.

# MongoDB Atlas connection string (Atlas → your cluster → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=pytrek

# Database name inside the cluster
MONGODB_DB=pytrek

# ---- Email (account verification + password resets) ----
# "console" = don't send, just log a notice (local dev). "smtp" = really send.
EMAIL_PROVIDER=smtp
# Pilot: the project Gmail account. To switch providers later, change only these.
#   Gmail:  smtp.gmail.com, 465, secure true, user = full Gmail address, pass = app password
#   Resend: smtp.resend.com, 465, secure true, user = resend, pass = Resend API key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<project-address>@gmail.com
SMTP_PASS=<16-character app password>
EMAIL_FROM="PyTrek <<project-address>@gmail.com>"
